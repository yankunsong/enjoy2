# Local Web Enjoy credentials.
#
# Copy to `.env` — in this directory or the repository root — and fill in the
# keys you have. `.env` is gitignored; this file is the documentation.
#
# These are read once when the local server starts and written into the same
# settings the preference boxes write, so a key set here shows up in
# Preferences → Advanced and is used by everything downstream. A variable set
# here wins over what is stored; a variable left out changes nothing, so you
# can keep some keys here and type the others into the boxes.
#
# Already exported in your shell? That wins over this file.

# Transcription. Also the default engine behind the AI features that still
# compile, though those are outside what Local Web Enjoy sets out to do.
OPENAI_API_KEY=

# Optional: an OpenAI-compatible endpoint other than OpenAI's own.
# OPENAI_BASE_URL=

# Pronunciation assessment, which is Azure's alone — OpenAI has no phoneme-level
# equivalent. Both are needed; the region is the one your Speech resource was
# created in, e.g. eastus.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Speech synthesis. The voices you can pick from are the ones this key reaches,
# so the list in Preferences stays empty until it is set.
ELEVENLABS_API_KEY=
